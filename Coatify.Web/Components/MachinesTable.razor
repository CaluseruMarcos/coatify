@namespace Coatify.Web.Components
@using Coatify.Shared
<h3>MachinesTable</h3>
<h4>
    Available Devices: @Devices.Count
</h4>
@if (Devices.Count > 0)
{
    foreach (var device in Devices)
    {
        <div>
            <NavLink href="@($"/details/{device.Id}")">
                <h5>@device.Name</h5>
            </NavLink>
            <span>@device.Status</span>
        </div>
        
    }
}
else
{
    <p>No devices</p>
}


@code {
    [Parameter]
    public List<DeviceResponse> Devices { get; set; } = [];
}