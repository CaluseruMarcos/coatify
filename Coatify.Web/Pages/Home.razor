@page "/"
@inject HttpClient HttpClient



<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app, made by Marcos.
<pre>@listOfAllDevices.Content.ReadAsStringAsync().Result</pre>
<button @onclick="GetADevice">Click me</button>

@code {
    private async Task GetADevice()
    {
      var request = await HttpClient.GetAsync("api/devices/all");
      
      if(!request.IsSuccessStatusCode) throw new Exception($"Request failed with status code: {request.StatusCode}");
      Console.WriteLine(request.Content.ReadAsStringAsync().Result);
      
        
    }
}

@code {
    private HttpResponseMessage listOfAllDevices;

    void SomeStartupMethod()
    {
        // Do Some Work
    }

    async Task<HttpResponseMessage> SomeStartupTask()
    {
        var request = await HttpClient.GetAsync("api/devices/all");
        return !request.IsSuccessStatusCode ? throw new Exception($"Request failed with status code: {request.StatusCode}") : request;
    }

    protected override async Task OnInitializedAsync()
    {
        
        listOfAllDevices = await SomeStartupTask();
        Console.WriteLine(listOfAllDevices.Content.ReadAsStringAsync().Result);
        
    }

}