@page "/"
@inject HttpClient HttpClient
@using Coatify.Shared
@using Coatify.Web.Components

<PageTitle>Geräte</PageTitle>
<h1>Geräte</h1>
<NavLink href="/devices/new">Gerät anlegen</NavLink>

@if (loading)
{
    <p>Laden...</p>
}
else if (errorMessage is not null)
{
    <p role="alert">@errorMessage</p>
    <button @onclick="LoadDevices">Wiederholen</button>
}
else if (devices is { Count: 0 })
{
    <p>Noch keine Geräte</p>
}
else if (devices is not null)
{
    <MachinesTable Devices="devices" />
}

@code {
    private List<DeviceResponse>? devices;
    private string? errorMessage;
    private bool loading;

    protected override Task OnInitializedAsync() => LoadDevices();

    private async Task LoadDevices()
    {
        loading = true;
        errorMessage = null;
        try
        {
            using var response = await HttpClient.GetAsync("api/devices");
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = $"Die Geräteliste konnte nicht geladen werden ({(int)response.StatusCode}).";
                return;
            }

            devices = await response.Content.ReadFromJsonAsync<List<DeviceResponse>>() ?? [];
        }
        catch (HttpRequestException)
        {
            errorMessage = "Die Geräteliste ist momentan nicht erreichbar.";
        }
        finally
        {
            loading = false;
        }
    }
}
